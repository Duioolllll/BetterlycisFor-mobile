<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="io.betterlyrics.widgettest">
    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="28" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <instrumentation android:name=".FontInstrumentation" android:targetPackage="io.betterlyrics.mobile" android:functionalTest="true" />
    <instrumentation android:name=".PlaylistInstrumentation" android:targetPackage="io.betterlyrics.mobile" android:functionalTest="true" />
    <application android:label="Widget Test Host" android:theme="@android:style/Theme.Material.Light.NoActionBar" android:debuggable="true">
        <activity android:name=".WidgetHostActivity" android:exported="true" android:launchMode="singleTop" />
        <activity android:name=".GrantActivity" android:exported="true" />
        <provider android:name=".FixtureDocuments" android:authorities="io.betterlyrics.widgettest.documents" android:exported="true" android:grantUriPermissions="true" android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter><action android:name="android.content.action.DOCUMENTS_PROVIDER" /></intent-filter>
        </provider>
    </application>
</manifest>
